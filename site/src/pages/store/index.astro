---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const teeUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-t-shirt';
const stickerUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-bumper-sticker';
const mugUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-black-glossy-mug';
---

<Layout title="Merchandise" description="Shop the Face Forward First Edition: the Double-F mark on a T-shirt, bumper sticker, and black glossy mug.">
  <NavBar />
  <main id="main">
    <header class="border-b rule">
      <div class="mx-auto grid max-w-[1440px] gap-14 px-5 py-20 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:px-12 lg:py-28">
        <div>
          <p class="eyebrow text-gold">Face Forward · First Edition</p>
          <h1 class="mt-6 max-w-3xl text-5xl leading-[.92] sm:text-6xl lg:text-8xl">Wear the position.</h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-chalk/65">
            The Double-F mark on a black T-shirt, bumper sticker, and glossy mug. Available through the Face Forward shop on Fourthwall.
          </p>
          <a href="#collection" class="mt-9 inline-flex min-h-11 items-center border-b-2 border-gold pb-1 text-xs font-bold uppercase tracking-[.14em] text-gold hover:border-chalk hover:text-chalk">
            Shop the First Edition <span class="ml-3" aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="merch-collage" aria-label="Face Forward First Edition merchandise">
          <a href={teeUrl} target="_blank" rel="noreferrer" class="hero-product hero-tee" aria-label="Shop the Face Forward T-shirt on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-t-shirt.webp"
              alt="Black Face Forward T-shirt with the Double-F parking mark in Chalk, Safety Gold, and gray."
              width="960"
              height="720"
              decoding="async"
              fetchpriority="high"
            />
          </a>
          <a href={stickerUrl} target="_blank" rel="noreferrer" class="hero-product hero-sticker" aria-label="Shop the Face Forward bumper sticker on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-bumper-sticker.webp"
              alt="Long Face Forward bumper sticker with the Double-F mark and Face facts. Face forward. message."
              width="960"
              height="720"
              decoding="async"
            />
          </a>
          <a href={mugUrl} target="_blank" rel="noreferrer" class="hero-product hero-mug" aria-label="Shop the Face Forward black glossy mug on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-black-glossy-mug.webp"
              alt="Black glossy Face Forward mug with the Double-F mark and Safety Gold website stripe."
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </header>

    <section id="collection" class="bg-paper text-asphalt" aria-labelledby="collection-heading">
      <div class="mx-auto max-w-[1440px] px-5 py-20 lg:px-12 lg:py-28">
        <div class="mb-12 flex flex-col justify-between gap-4 border-b border-asphalt/15 pb-6 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow text-asphalt/45">The First Edition</p>
            <h2 id="collection-heading" class="mt-4 text-4xl sm:text-5xl">Choose your piece.</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-asphalt/60">The Face Forward identity, made for the shirt, the car, and the coffee break.</p>
        </div>

        <div class="grid gap-16 lg:grid-cols-3 lg:gap-8">
          <article>
            <p class="eyebrow text-asphalt/45">01 · T-shirt</p>
            <a
              href={teeUrl}
              class="product-stage mt-6"
              target="_blank"
              rel="noreferrer"
              aria-label="View the Face Forward T-shirt on Fourthwall (opens in a new tab)"
            >
              <img
                src="/assets/merchandise/face-forward-t-shirt.webp"
                alt="Black Face Forward T-shirt with the Double-F parking mark in Chalk, Safety Gold, and gray."
                width="960"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3 class="mt-6 text-2xl">Face Forward T-shirt</h3>
            <p class="mt-3 text-sm leading-6 text-asphalt/65">The full Face Forward lockup in Chalk and Safety Gold on a black tee.</p>
            <a href={teeUrl} target="_blank" rel="noreferrer" class="product-link">
              Shop the T-shirt <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article>
            <p class="eyebrow text-asphalt/45">02 · Bumper sticker</p>
            <a
              href={stickerUrl}
              class="product-stage mt-6"
              target="_blank"
              rel="noreferrer"
              aria-label="View the Face Forward bumper sticker on Fourthwall (opens in a new tab)"
            >
              <img
                src="/assets/merchandise/face-forward-bumper-sticker.webp"
                alt="Long Face Forward bumper sticker with the Double-F mark and Face facts. Face forward. message."
                width="960"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3 class="mt-6 text-2xl">Face Forward bumper sticker</h3>
            <p class="mt-3 text-sm leading-6 text-asphalt/65">The Double-F mark and campaign line in a long-format bumper sticker.</p>
            <a href={stickerUrl} target="_blank" rel="noreferrer" class="product-link">
              Shop the sticker <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article>
            <p class="eyebrow text-asphalt/45">03 · Black glossy mug</p>
            <a
              href={mugUrl}
              class="product-stage mt-6"
              target="_blank"
              rel="noreferrer"
              aria-label="View the Face Forward black glossy mug on Fourthwall (opens in a new tab)"
            >
              <img
                src="/assets/merchandise/face-forward-black-glossy-mug.webp"
                alt="Black glossy Face Forward mug with the Double-F mark and Safety Gold website stripe."
                width="960"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3 class="mt-6 text-2xl">Face Forward black glossy mug</h3>
            <p class="mt-3 text-sm leading-6 text-asphalt/65">The Double-F mark wrapped around a black glossy mug, finished with a Safety Gold website stripe.</p>
            <a href={mugUrl} target="_blank" rel="noreferrer" class="product-link">
              Shop the mug <span aria-hidden="true">↗</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y rule bg-night text-chalk" aria-labelledby="sign-heading">
      <div class="mx-auto grid max-w-[1440px] gap-14 px-5 py-20 lg:grid-cols-[.75fr_1.25fr] lg:items-center lg:px-12 lg:py-28">
        <div>
          <p class="eyebrow text-gold">Campaign object · Not for sale</p>
          <h2 id="sign-heading" class="mt-6 max-w-xl text-4xl leading-[.98] sm:text-5xl lg:text-6xl">Built for the parking lot.</h2>
          <p class="mt-7 max-w-lg leading-7 text-chalk/68">
            The 12 × 18-inch aluminum sign takes Face Forward back to where it started: the parking lot. One copy is reserved as a personal First Edition artifact.
          </p>
        </div>

        <figure class="mx-auto w-full max-w-[620px] bg-concrete p-5 text-asphalt sm:p-8">
          <img
            src="/assets/merchandise/face-forward-parking-sign-12x18.webp"
            alt="Face Forward Only parking sign with a black Double-F parking-stall mark, two gold and two gray cars, and parkfaceforward.org on a gold footer."
            width="1440"
            height="2160"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full shadow-[12px_14px_0_rgba(19,19,22,.16)]"
          />
          <figcaption class="mt-6 flex flex-col justify-between gap-2 text-[10px] font-bold uppercase tracking-[.14em] text-asphalt/55 sm:flex-row">
            <span>12 × 18 in · aluminum sign artwork</span>
            <span>Personal artifact · Not for sale</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="bg-gold text-asphalt">
      <div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-8 px-5 py-16 sm:flex-row sm:items-end lg:px-12">
        <div>
          <p class="eyebrow text-asphalt/55">Face Forward shop</p>
          <h2 class="mt-4 text-4xl sm:text-5xl">Take the position with you.</h2>
        </div>
        <a href="https://face-forward-shop.fourthwall.com/" target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center bg-asphalt px-7 text-xs font-bold uppercase tracking-[.14em] text-chalk hover:bg-chalk hover:text-asphalt">
          Shop on Fourthwall <span class="ml-3" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .merch-collage {
    display: grid;
    min-height: 440px;
    grid-template-columns: 1.06fr .94fr;
    grid-template-rows: 1fr 1fr;
    gap: .75rem;
  }

  .hero-product {
    display: block;
    overflow: hidden;
    background: #e5e5e5;
  }

  .hero-tee { grid-row: 1 / 3; }

  .hero-product img,
  .product-stage img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .hero-product:hover img,
  .product-stage:hover img { transform: scale(1.018); }

  .hero-product:focus-visible,
  .product-stage:focus-visible {
    outline: 3px solid #E8B62B;
    outline-offset: 4px;
  }

  .product-stage {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid rgba(19, 19, 22, .12);
    background: #e5e5e5;
  }

  .product-link {
    margin-top: 1.25rem;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: .6rem;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .product-link:hover { color: #8a6410; }

  @media (max-width: 640px) {
    .merch-collage {
      min-height: 330px;
      gap: .5rem;
    }
  }
</style>