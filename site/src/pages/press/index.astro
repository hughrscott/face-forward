---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Layout title="Press" description="Press kit, brand assets, and background on Face Forward.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">Press</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Press resources.</h1>
      <p class="mt-4 leading-relaxed text-chalk/70">
        Everything you need to write about Face Forward, in one place.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <a href="/docs/press-kit.zip" class="card-surface rounded-sm p-6 transition-brand duration-200 hover:border-gold/60">
          <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Download</p>
          <h2 class="mt-2 font-display text-lg font-semibold">Logo Pack</h2>
          <p class="mt-2 text-sm text-chalk/65">Wordmark, Double-F mark, and stall variants in SVG/PNG.</p>
        </a>
        <a href="/docs/one-pager.pdf" class="card-surface rounded-sm p-6 transition-brand duration-200 hover:border-gold/60">
          <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Download</p>
          <h2 class="mt-2 font-display text-lg font-semibold">One-Pager</h2>
          <p class="mt-2 text-sm text-chalk/65">Mission, four pillars, and key facts in a single page.</p>
        </a>
        <a href="/about/" class="card-surface rounded-sm p-6 transition-brand duration-200 hover:border-gold/60">
          <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Read</p>
          <h2 class="mt-2 font-display text-lg font-semibold">Leadership Bios</h2>
          <p class="mt-2 text-sm text-chalk/65">Background on the collective behind Face Forward.</p>
        </a>
        <a href="/research/" class="card-surface rounded-sm p-6 transition-brand duration-200 hover:border-gold/60">
          <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Read</p>
          <h2 class="mt-2 font-display text-lg font-semibold">Research Stats</h2>
          <p class="mt-2 text-sm text-chalk/65">Key figures from the 10,000-run kinematic simulation.</p>
        </a>
      </div>

      <p class="mt-10 text-sm text-chalk/60">
        Media inquiries: <a class="text-gold underline" href="mailto:press@parkfaceforward.org">press@parkfaceforward.org</a>
      </p>
    </div>
  </main>
  <SiteFooter />
</Layout>
