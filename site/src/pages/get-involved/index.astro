---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Layout title="Get Involved" description="Take the Face Forward pledge, download a Chapter Starter Kit, or share your parking story.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-4xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">Get Involved</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Join the small choice.</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-chalk/70">
        Face Forward grows one thoughtful driver at a time. Here are a few ways to take part.
      </p>

      <section class="mt-12 card-surface rounded-sm p-8">
        <h2 class="font-display text-xl font-semibold">Take the pledge</h2>
        <p class="mt-2 max-w-lg text-sm leading-relaxed text-chalk/70">
          Add your name and email to join drivers who park face forward whenever practical.
        </p>
        <form
          action="https://buttondown.email/api/emails/embed-subscribe/faceforward"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.email/faceforward', 'popupwindow')"
          class="mt-6 grid gap-3 sm:grid-cols-[1fr_1fr_auto]"
        >
          <label class="sr-only" for="pledge-name">Name</label>
          <input id="pledge-name" name="name" type="text" placeholder="Name" required
            class="rounded-sm border border-chalk/25 bg-forest px-4 py-3 text-sm text-chalk placeholder:text-chalk/40 focus:border-gold focus:outline-none" />
          <label class="sr-only" for="pledge-email">Email</label>
          <input id="pledge-email" name="email" type="email" placeholder="you@example.com" required
            class="rounded-sm border border-chalk/25 bg-forest px-4 py-3 text-sm text-chalk placeholder:text-chalk/40 focus:border-gold focus:outline-none" />
          <button type="submit"
            class="whitespace-nowrap rounded-sm bg-gold px-5 py-3 text-sm font-semibold uppercase tracking-[.08em] text-forest transition-brand duration-200 hover:brightness-110">
            Sign the Pledge
          </button>
        </form>
      </section>

      <section class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="card-surface rounded-sm p-8">
          <h2 class="font-display text-xl font-semibold">Start a chapter</h2>
          <p class="mt-2 text-sm leading-relaxed text-chalk/70">
            Everything you need to introduce Face Forward to your community, HOA, or workplace.
          </p>
          <a
            href="/docs/chapter-starter-kit.pdf"
            class="mt-5 inline-block rounded-sm border border-chalk/25 px-5 py-3 text-xs font-semibold uppercase tracking-[.1em] text-chalk transition-brand duration-200 hover:border-gold hover:text-gold"
          >
            Download Chapter Starter Kit
          </a>
        </div>
        <div class="card-surface rounded-sm p-8">
          <h2 class="font-display text-xl font-semibold">Share your parking story</h2>
          <p class="mt-2 text-sm leading-relaxed text-chalk/70">
            Tell us about a moment of parking courtesy &mdash; or its absence &mdash; that stuck with you.
          </p>
          <a
            href="https://forms.gle/faceforward-stories"
            target="_blank"
            rel="noreferrer"
            class="mt-5 inline-block rounded-sm border border-chalk/25 px-5 py-3 text-xs font-semibold uppercase tracking-[.1em] text-chalk transition-brand duration-200 hover:border-gold hover:text-gold"
          >
            Share Your Story
          </a>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Layout>
