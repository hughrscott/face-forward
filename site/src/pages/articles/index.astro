---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout title="Articles" description="Thoughtful essays and evidence-based discussions from Face Forward.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">The Articles</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Thoughtful essays, evidence-based discussions.</h1>
      <p class="mt-4 max-w-2xl text-chalk/65">
        Rather than publishing research for its own sake, Face Forward writes to encourage
        conversation about the small habits that shape shared public space.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allArticles.map((article) => (
          <a
            href={`/articles/${article.id}/`}
            class="card-surface group flex flex-col rounded-sm p-6 transition-brand duration-200 hover:border-gold/60"
          >
            <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[.16em] text-gold">
              <span>{article.data.tag}</span>
              <span class="text-chalk/40">{article.data.readTime}</span>
            </div>
            <h2 class="mt-4 font-display text-xl font-semibold leading-snug group-hover:text-gold">
              {article.data.title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-chalk/65">{article.data.excerpt}</p>
            <span class="mt-5 text-sm font-semibold text-gold">Read the article &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
