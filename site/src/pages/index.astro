---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnimatedHero from '../components/AnimatedHero.astro';
import TopViewCar from '../components/TopViewCar.astro';

const steps = [
  {
    number: '01',
    name: 'Approach',
    body: 'See the stall. Signal early. Give the aisle a clear idea of what happens next.',
    state: 'empty',
  },
  {
    number: '02',
    name: 'Commit',
    body: 'Turn in once. Make the simple maneuver look as simple as it is.',
    state: 'turning',
  },
  {
    number: '03',
    name: 'Arrive',
    body: 'Front bumper to the line. Engine off. You came here to be here.',
    state: 'parked',
  },
];

const teeUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-t-shirt';
const stickerUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-bumper-sticker';
const mugUrl = 'https://face-forward-shop.fourthwall.com/products/face-forward-black-glossy-mug';
---
<Layout
  title="Home"
  description="Face facts. Face forward. An observed, design-led civic case for forward-entry, nose-in parking."
  image="/assets/research/dlp-headline-card.png"
>
  <NavBar />
  <main id="main">
    <AnimatedHero />

    <section id="finding" class="border-y border-asphalt/15 bg-paper text-asphalt">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 py-20 lg:grid-cols-[.72fr_1.28fr] lg:items-center lg:px-12 lg:py-28">
        <div>
          <p class="eyebrow text-asphalt/50">What the data says. A study in parking.</p>
          <p class="mt-8 font-display text-[clamp(4rem,10vw,9rem)] font-black leading-[.78] tracking-[-.065em] text-gold">10.0</p>
          <p class="mt-5 font-display text-3xl font-black uppercase tracking-[-.035em] sm:text-4xl">Seconds faster.<br />End to end.</p>
          <p class="mt-6 max-w-md text-base leading-7 text-asphalt/70">
            In the Dragon Lake Parking Dataset, forward-entry / nose-in parking averaged 36.2 seconds across entry and exit. Reverse-entry / nose-out averaged 46.2 seconds.
          </p>
          <a href="/research/" class="mt-8 inline-flex min-h-11 items-center border-b-2 border-asphalt pb-1 text-xs font-bold uppercase tracking-[.14em] hover:border-gold hover:text-gold">
            See the evidence <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>
        <a href="/research/" class="block overflow-hidden border border-asphalt/15 bg-asphalt" aria-label="Read the observed parking timing study">
          <img
            src="/assets/research/dlp-lifecycle-comparison.svg"
            alt="Nose-in parking averaged 36.2 seconds across entry and exit, compared with 46.2 seconds for reverse-entry nose-out parking."
            class="h-auto w-full transition-brand duration-300 hover:scale-[1.01]"
            width="1920"
            height="1200"
          />
        </a>
      </div>
    </section>

    <section id="position" class="bg-asphalt text-chalk">
      <div class="mx-auto max-w-[1440px] px-5 py-20 lg:px-12 lg:py-32">
        <p class="eyebrow text-chalk/45">The position</p>
        <h2 class="mt-7 max-w-5xl text-[clamp(2.75rem,6.5vw,6.5rem)] leading-[.94] tracking-[-.055em]">
          We don’t park to exit.<br /><span class="text-gold">We park to arrive.</span><br />Enjoy the destination.
        </h2>
        <div class="mt-14 grid max-w-5xl gap-8 text-base leading-8 text-chalk/68 md:grid-cols-2 md:gap-16">
          <p>
            A parking lot is a shared public space disguised as an errand. Other drivers are watching your brake lights, turn signals, and hesitation to decipher your intent. Parking face forward is a small courtesy.
          </p>
          <p>
            Driving directly into the stall when the setting allows it makes your arrival legible, predictable, and quick. Park up. Get out. Enjoy the destination.
          </p>
        </div>
        <a href="/manifesto/" class="mt-10 inline-flex min-h-11 items-center text-xs font-bold uppercase tracking-[.14em] text-gold hover:text-chalk">
          Read the manifesto <span class="ml-3" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="border-y rule bg-night text-chalk">
      <div class="mx-auto max-w-[1440px] px-5 py-20 lg:px-12 lg:py-28">
        <p class="eyebrow text-chalk/45">The three-point practice</p>
        <h2 class="mt-6 text-4xl leading-none sm:text-5xl lg:text-6xl">Clear intent. Courteous action.</h2>
        <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-0">
          {steps.map((step, index) => (
            <article class:list={['relative border-t-2 border-gold pt-7 md:px-8', index === 0 && 'md:pl-0', index > 0 && 'md:border-l md:border-l-chalk/10']}>
              <div class="parking-study" aria-hidden="true">
                <span class="stall"></span>
                {step.state !== 'empty' && <TopViewCar class={`study-car text-gold ${step.state}`} />}
              </div>
              <h3 class="mt-6 text-sm font-black uppercase tracking-[.1em] text-gold">{step.number} — {step.name}</h3>
              <p class="mt-3 max-w-sm text-sm leading-6 text-chalk/68">{step.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-paper text-asphalt">
      <div class="mx-auto grid max-w-[1440px] gap-12 px-5 py-20 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-12 lg:py-28">
        <div>
          <p class="eyebrow text-asphalt/50">Face Forward · First Edition</p>
          <h2 class="mt-6 max-w-xl text-4xl leading-[.98] sm:text-5xl lg:text-6xl">Spread the word.</h2>
          <p class="mt-6 max-w-lg leading-7 text-asphalt/68">
            Purchase merchandise online and show your friends, neighbors and coparkers why you face facts, and face forward.
          </p>
          <a href="/store/" class="mt-8 inline-flex min-h-11 items-center text-xs font-bold uppercase tracking-[.14em] text-asphalt hover:text-gold">
            Shop the First Edition <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="home-merch-grid" aria-label="Face Forward First Edition merchandise">
          <a href={teeUrl} target="_blank" rel="noreferrer" class="home-merch-item home-merch-tee" aria-label="Shop the Face Forward T-shirt on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-t-shirt.webp"
              alt="Black Face Forward T-shirt with the Double-F parking mark in Chalk, Safety Gold, and gray."
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span>T-shirt ↗</span>
          </a>
          <a href={stickerUrl} target="_blank" rel="noreferrer" class="home-merch-item" aria-label="Shop the Face Forward bumper sticker on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-bumper-sticker.webp"
              alt="Long Face Forward bumper sticker with the Double-F mark and Face facts. Face forward. message."
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span>Bumper sticker ↗</span>
          </a>
          <a href={mugUrl} target="_blank" rel="noreferrer" class="home-merch-item" aria-label="Shop the Face Forward black glossy mug on Fourthwall (opens in a new tab)">
            <img
              src="/assets/merchandise/face-forward-black-glossy-mug.webp"
              alt="Black glossy Face Forward mug with the Double-F mark and Safety Gold website stripe."
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span>Black glossy mug ↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-gold text-asphalt">
      <div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-10 px-5 py-16 md:flex-row md:items-end lg:px-12 lg:py-20">
        <div>
          <p class="eyebrow text-asphalt/55">The invitation</p>
          <h2 class="mt-5 text-4xl leading-none sm:text-5xl lg:text-6xl">Forward, together.</h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-asphalt/68">Try the simpler arrival. Notice what changes. Keep your exceptions and your sense of humor.</p>
        </div>
        <a href="/manifesto/" class="inline-flex min-h-12 flex-none items-center justify-center bg-asphalt px-7 text-xs font-bold uppercase tracking-[.14em] text-chalk hover:bg-chalk hover:text-asphalt">Take the position</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .parking-study {
    position: relative;
    height: 84px;
  }

  .stall {
    position: absolute;
    left: 0;
    top: 20px;
    width: 132px;
    height: 48px;
    border: 2px dashed rgba(242, 240, 234, 0.3);
  }

  :global(.study-car) {
    position: absolute;
    left: 48px;
    top: 28px;
    width: 104px;
    height: 32px;
  }

  :global(.study-car.turning) { transform: rotate(-11deg); }
  :global(.study-car.parked) { left: 13px; }


  .home-merch-grid {
    display: grid;
    min-height: 440px;
    grid-template-columns: 1.06fr .94fr;
    grid-template-rows: 1fr 1fr;
    gap: .6rem;
  }

  .home-merch-item {
    position: relative;
    display: block;
    overflow: hidden;
    background: #e5e5e5;
  }

  .home-merch-tee { grid-row: 1 / 3; }

  .home-merch-item img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .home-merch-item span {
    position: absolute;
    bottom: 0;
    left: 0;
    background: #131316;
    padding: .7rem .85rem;
    color: #F2F0EA;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .home-merch-item:hover img { transform: scale(1.018); }

  .home-merch-item:focus-visible {
    outline: 3px solid #E8B62B;
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .home-merch-grid {
      min-height: 340px;
      gap: .5rem;
    }

    .home-merch-item span {
      padding: .55rem .65rem;
      font-size: .55rem;
    }
  }
</style>