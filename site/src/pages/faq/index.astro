---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const faqs = [
  {
    q: 'Is Face Forward a real organization?',
    a: 'Face Forward is a civic-advocacy project exploring how a small, everyday habit — the direction you park — intersects with courtesy, safety, and shared public space. We take the argument seriously and back it with a genuine kinematic simulation.',
  },
  {
    q: 'Are you saying reverse parking is wrong?',
    a: 'No. Our position is that forward parking is often more considerate and efficient when practical — not that reverse parking is a mistake. Reasonable people can disagree, and we welcome that discussion.',
  },
  {
    q: 'What is the basis for your safety claims?',
    a: 'A Monte Carlo kinematic simulation of 10,000 parking maneuvers, modeling Ackermann steering, driver reaction latency, and line-of-sight obstruction from neighboring vehicles. Full methodology is on the Research page.',
  },
  {
    q: 'How can I get involved?',
    a: 'Sign the pledge, share your parking story, or start a local chapter — all on the Get Involved page.',
  },
  {
    q: 'Do you sell merchandise?',
    a: 'Yes — a small, considered collection of caps, polos, and pins, fulfilled through our Printful storefront.',
  },
];
---
<Layout title="FAQ" description="Frequently asked questions about Face Forward.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">FAQ</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Frequently asked questions.</h1>

      <div class="mt-10 divide-y rule border-t rule">
        {faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between font-display text-lg font-semibold">
              {item.q}
              <span class="ml-4 text-gold transition-brand duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-chalk/70">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
