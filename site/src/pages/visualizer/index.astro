---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Layout title="Visualizer" description="Compare forward and reverse parking maneuvers side by side, driven by the Project Parkway kinematic simulation.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-6xl px-5 py-10 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">The Instrument</p>
          <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">Maneuver Observatory</h1>
        </div>
        <button
          id="copy-permalink"
          type="button"
          class="rounded-sm border border-chalk/25 px-4 py-2 text-xs font-semibold uppercase tracking-[.1em] text-chalk transition-brand duration-200 hover:border-gold hover:text-gold"
        >
          Copy permalink
        </button>
      </div>
      <p class="mt-3 max-w-2xl text-sm text-chalk/60">
        Rear-axle trajectories replayed from the Project Parkway kinematic model. Adjust the conditions below —
        the URL updates automatically so you can share exactly what you're looking at.
      </p>
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-6 lg:px-8">
      <div class="overflow-hidden rounded-sm border rule">
        <iframe
          id="visualizer-frame"
          src="/visualizer/embed/"
          title="Face Forward parking maneuver visualizer"
          class="h-[900px] w-full border-0 lg:h-[1000px]"
          loading="eager"
        ></iframe>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-16 lg:px-8">
      <details class="card-surface rounded-sm p-6">
        <summary class="cursor-pointer font-display text-lg font-semibold">How this works</summary>
        <div class="mt-4 space-y-3 text-sm leading-relaxed text-chalk/70">
          <p>
            The visualizer replays canonical rear-axle trajectories generated by our Python kinematic simulator
            (Ackermann steering model, 2.8m wheelbase). Background paths are pre-computed; foreground driver and
            pedestrian interactions are calculated live in your browser.
          </p>
          <p>
            <strong>Pedestrian density</strong> sets the rate of pedestrians crossing the aisle.
            <strong>Aisle width</strong> sets the available maneuvering space.
            <strong>SUV presence</strong> sets the probability that neighboring stalls are occupied by
            larger vehicles that reduce line-of-sight.
            <strong>Maneuver speed</strong> scales playback without altering the underlying physics.
          </p>
          <p>
            Full model documentation, including the Monte Carlo protocol and statistical results, is available on
            the <a class="text-gold underline" href="/research/">Research page</a>.
          </p>
        </div>
      </details>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  const frame = document.getElementById('visualizer-frame') as HTMLIFrameElement;
  const copyBtn = document.getElementById('copy-permalink');

  const params = new URLSearchParams(window.location.search);
  const allowed = ['aisle', 'ped', 'suv', 'speed'];
  const forwarded = new URLSearchParams();
  for (const key of allowed) {
    const value = params.get(key);
    if (value) forwarded.set(key, value);
  }
  const query = forwarded.toString();
  frame.src = `/visualizer/embed/${query ? `?${query}` : ''}`;

  window.addEventListener('message', (event) => {
    if (!event.data || event.data.source !== 'face-forward-visualizer') return;
    const next = new URLSearchParams(window.location.search);
    for (const key of allowed) {
      if (event.data.state?.[key] !== undefined) {
        next.set(key, String(event.data.state[key]));
      }
    }
    const nextUrl = `${window.location.pathname}?${next.toString()}`;
    window.history.replaceState({}, '', nextUrl);
  });

  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    const original = copyBtn.textContent;
    copyBtn.textContent = 'Copied!';
    setTimeout(() => {
      copyBtn.textContent = original;
    }, 1600);
  });
</script>
