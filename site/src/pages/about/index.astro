---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Layout title="About" description="Mission, values, and leadership behind Face Forward.">
  <NavBar />
  <main id="main">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-gold">About</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Small choices. Better communities.</h1>

      <section class="mt-12">
        <h2 class="font-display text-2xl font-semibold">Mission</h2>
        <p class="mt-3 leading-relaxed text-chalk/75">
          Face Forward is a civic organization dedicated to promoting thoughtful parking through education,
          discussion, and advocacy. We believe that small acts of consideration &mdash; however ordinary they may
          seem &mdash; help build stronger, more courteous communities.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-2xl font-semibold">Values</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {['Thoughtful', 'Optimistic', 'Civic-minded', 'Calm', 'Intelligent', 'Welcoming', 'Practical', 'Quietly confident'].map((v) => (
            <li class="card-surface rounded-sm px-4 py-3 text-sm text-chalk/80">{v}</li>
          ))}
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-chalk/60">
          We are never sarcastic, angry, partisan, or mocking. We speak with confidence, and with humility.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-2xl font-semibold">Leadership</h2>
        <p class="mt-3 leading-relaxed text-chalk/75">
          Face Forward is led by a small collective of researchers, designers, and civic-minded volunteers who
          believe the details of everyday life are worth taking seriously.
        </p>
      </section>

      <section id="contact" class="mt-10">
        <h2 class="font-display text-2xl font-semibold">Contact</h2>
        <p class="mt-3 leading-relaxed text-chalk/75">
          Questions, press inquiries, or chapter proposals: <a class="text-gold underline" href="mailto:hello@parkfaceforward.org">hello@parkfaceforward.org</a>
        </p>
      </section>
    </div>
  </main>
  <SiteFooter />
</Layout>
