---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Face Forward — Small choices. Better communities. A civic case for thoughtful, forward-facing parking.',
  image,
} = Astro.props;
const socialImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Face Forward</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131316" />
    <meta property="og:title" content={`${title} · Face Forward`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta name="twitter:card" content="summary_large_image" />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:m-3 focus:rounded focus:bg-gold focus:px-4 focus:py-2 focus:text-forest">Skip to content</a>
    <slot />
  </body>
</html>
