---
import FFMark from './FFMark.astro';

const year = new Date().getFullYear();
---
<footer class="no-print border-t rule bg-night">
  <div class="mx-auto max-w-[1440px] px-5 py-12 lg:px-12 lg:py-14">
    <div class="flex flex-col justify-between gap-10 md:flex-row md:items-start">
      <div class="max-w-sm">
        <div class="flex items-center gap-3 text-chalk/70">
          <FFMark class="text-xl text-gold" />
          <span class="font-display text-sm font-black tracking-[.06em]">FACEFORWARD</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-chalk/45">Face facts. Face forward. Follow your nose. A small choice with a big impact.</p>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-3 text-xs font-bold uppercase tracking-[.12em] text-chalk/55 sm:grid-cols-4">
        <a class="hover:text-gold" href="/research/">Evidence</a>
        <a class="hover:text-gold" href="/manifesto/">Manifesto</a>
        <a class="hover:text-gold" href="/store/">Merchandise</a>
        <a class="hover:text-gold" href="/about/">About</a>
      </nav>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t rule pt-6 text-[10px] uppercase tracking-[.13em] text-chalk/35 sm:flex-row sm:justify-between">
      <span>&copy; {year} Face Forward. All rights forward.</span>
      <span>Observed evidence. Reasoned position. Individual choice.</span>
    </div>
  </div>
</footer>
