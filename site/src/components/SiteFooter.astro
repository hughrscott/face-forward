---
const year = new Date().getFullYear();
---
<footer class="no-print border-t rule">
  <div class="mx-auto max-w-6xl px-5 py-12 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold"><span class="text-gold">Face</span> Forward</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-chalk/60">
          Small choices. Better communities. A civic case for thoughtful, forward-facing parking.
        </p>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Organization</p>
        <ul class="mt-3 space-y-2 text-sm text-chalk/70">
          <li><a class="hover:text-gold" href="/about/">About</a></li>
          <li><a class="hover:text-gold" href="/press/">Press</a></li>
          <li><a class="hover:text-gold" href="/faq/">FAQ</a></li>
          <li><a class="hover:text-gold" href="/about/#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Research</p>
        <ul class="mt-3 space-y-2 text-sm text-chalk/70">
          <li><a class="hover:text-gold" href="/research/">Methodology</a></li>
          <li><a class="hover:text-gold" href="/visualizer/">Visualizer</a></li>
          <li><a class="hover:text-gold" href="https://github.com/hughrscott/face-forward" target="_blank" rel="noreferrer">GitHub</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[.16em] text-gold">Domain</p>
        <p class="mt-3 text-sm text-chalk/70">parkfaceforward.org</p>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t rule pt-6 text-xs text-chalk/40 sm:flex-row sm:justify-between">
      <span>&copy; {year} Face Forward. All rights reserved.</span>
      <span>Designed with care, in the spirit of the small choice.</span>
    </div>
  </div>
</footer>
