---
import FFMark from './FFMark.astro';

const links = [
  { href: '/research/', label: 'Evidence' },
  { href: '/manifesto/', label: 'Manifesto' },
  { href: '/store/', label: 'Merchandise' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b rule bg-asphalt/95">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 lg:h-[72px] lg:px-12">
    <a href="/" class="flex items-center gap-3 text-chalk" aria-label="Face Forward home">
      <FFMark class="text-xl text-gold lg:text-[22px]" />
      <span class="font-display text-sm font-black tracking-[.06em] lg:text-base">FACEFORWARD</span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'text-[11px] font-bold uppercase tracking-[.15em] transition-brand duration-200 hover:text-gold',
            current.startsWith(l.href) ? 'text-gold' : 'text-chalk/65',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <details class="md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center border border-chalk/25 px-4 text-xs font-bold uppercase tracking-[.14em]">Menu</summary>
      <div class="absolute left-0 right-0 top-full border-b rule bg-asphalt px-5 py-5">
        <nav aria-label="Primary mobile" class="flex flex-col gap-1">
          {links.map((l) => (
            <a href={l.href} class="flex min-h-11 items-center border-b border-chalk/10 text-sm font-bold uppercase tracking-[.12em] text-chalk/80 hover:text-gold">{l.label}</a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>
